{
  "mcpServers": {
    "postgres": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@bytebase/dbhub"],
      "env": {
        "DATABASE_URL": "${TEXT2SQL_DATABASE_URL}"
      }
    },
    "semantic-layer": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "python", "servers/semantic_layer.py"]
    }
  }
}
